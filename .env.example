# Postgres (local dev via docker-compose)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=aralau
DB_PASSWORD=aralau
DB_NAME=aralau

# Prisma datasource URL (used by prisma.config.ts and the runtime PrismaClient)
DATABASE_URL="postgresql://aralau:aralau@127.0.0.1:5432/aralau?schema=public"

# Session cookie sealing password (REQUIRED in production, 32+ chars)
NUXT_SESSION_PASSWORD="change-me-to-a-random-string-of-32+chars"

# Google OAuth (optional in local dev — login button is disabled when unset)
# Authorized redirect URI in Google Cloud Console: {origin}/api/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
